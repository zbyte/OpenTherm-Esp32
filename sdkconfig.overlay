# Applied on top of the platform sdkconfig via SDKCONFIG_DEFAULTS (see build.ps1).
# ESP32-S3FH4R2: the platform's S3 configs assume 16 MB flash + octal PSRAM.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
# OTA images boot "pending verify"; the supervisor confirms them after 60 s
# of healthy control, otherwise the bootloader rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Keep booting if PSRAM init fails: the firmware does not depend on it.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Browsers send long headers (User-Agent, Accept, Referer, Origin, Authorization);
# the default 512 bytes made web-form POSTs fail with "Header fields are too long".
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512

# The MQTT client task stays on the network core, away from OpenTherm (core 1).
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
