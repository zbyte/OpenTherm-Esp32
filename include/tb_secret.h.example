/* ThingsBoard defaults compiled into the firmware. Copy to tb_secret.h (kept
 * out of git). The values can be changed later on the board: web UI
 * "Подключение", or the CLI: tb host <name> [port] / tb token <token>. */
#define TB_HOST  "mqtt.eu.thingsboard.cloud"
#define TB_PORT  8883 /* 8883 = TLS, 1883 = plain */
#define TB_TOKEN "device-access-token"
